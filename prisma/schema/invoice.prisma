// ============================================================
// invoice.prisma
// Invoice Numbering (SRS Sec. 10) + Sales & Billing (SRS Sec. 9)
// ============================================================

/// Configurable numbering series, e.g. "TB/26-27/0001" (SRS Sec. 10)
model InvoiceSeries {
  id                String   @id @default(cuid())

  businessId        String
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  seriesName        String   // e.g. "Default", "Branch-Delhi"
  prefix            String   // e.g. "TB"
  financialYearTag  String?  // e.g. "26-27"
  startingNumber    Int      @default(1)
  currentNumber     Int      @default(0)
  isDefault         Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  invoices          Invoice[]

  @@unique([businessId, seriesName])
  @@map("invoice_series")
}

model Invoice {
  id                String        @id @default(cuid())

  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  seriesId          String?
  series            InvoiceSeries? @relation(fields: [seriesId], references: [id])

  invoiceNumber     String        // fully rendered, e.g. TB/26-27/0001
  invoiceDate       DateTime      @default(now())

  customerId        String?
  customer          Customer?     @relation(fields: [customerId], references: [id])
  customerName      String?       // e.g. "Walk-in Customer" or entered name
  customerPhone     String?

  billingAddress    String?
  shippingAddress   String?
  placeOfSupply     String?

  supplyType        GstSupplyType @default(B2C)
  isReverseCharge   Boolean       @default(false)

  subtotal          Decimal       @default(0) @db.Decimal(14, 2)
  discountPercent   Decimal       @default(0) @db.Decimal(5, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(14, 2)

  taxableValue      Decimal       @default(0) @db.Decimal(14, 2)
  cgstAmount        Decimal       @default(0) @db.Decimal(14, 2)
  sgstAmount        Decimal       @default(0) @db.Decimal(14, 2)
  igstAmount        Decimal       @default(0) @db.Decimal(14, 2)
  cessAmount        Decimal       @default(0) @db.Decimal(14, 2)
  roundOff          Decimal       @default(0) @db.Decimal(6, 2)
  grandTotal        Decimal       @default(0) @db.Decimal(14, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(14, 2)
  balanceAmount     Decimal       @default(0) @db.Decimal(14, 2)
  changeReturned    Decimal       @default(0) @db.Decimal(14, 2)
  amountInWords     String?

  paymentMode       PaymentMode?
  paymentStatus     PaymentStatus @default(UNPAID)

  notes             String?
  termsAndConditions String?

  status            InvoiceStatus @default(SAVED)
  isHeld            Boolean       @default(false)

  // e-Invoice / IRN readiness (SRS Sec. 20, Phase 4)
  irn               String?
  irnQrCode         String?
  eInvoiceGeneratedAt DateTime?

  createdByUserId   String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  items             InvoiceItem[]
  receiptAllocations ReceiptAllocation[]
  ledgerEntries     LedgerEntry[]
  salesReturns      SalesReturn[]
  creditNotes       CreditNote[]
  recurringProfile  RecurringInvoiceProfile? @relation(fields: [recurringProfileId], references: [id])
  recurringProfileId String?
  sales             Sale[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, customerId])
  @@map("invoices")
}

/// One line item on a sales invoice — either a Product or a Service
model InvoiceItem {
  id             String   @id @default(cuid())

  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId      String?
  product        Product? @relation(fields: [productId], references: [id])

  serviceId      String?
  service        Service? @relation(fields: [serviceId], references: [id])

  productName    String?
  hsnOrSacCode   String?
  quantity       Decimal  @default(1) @db.Decimal(12, 3)
  unit           String?  @default("PCS")
  rate           Decimal  @db.Decimal(12, 2)
  mrp            Decimal? @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountAmount Decimal  @default(0) @db.Decimal(14, 2)

  taxableValue   Decimal  @db.Decimal(14, 2)
  gstRatePercent Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount     Decimal  @default(0) @db.Decimal(14, 2)
  sgstAmount     Decimal  @default(0) @db.Decimal(14, 2)
  igstAmount     Decimal  @default(0) @db.Decimal(14, 2)
  cessAmount     Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal  @db.Decimal(14, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}
