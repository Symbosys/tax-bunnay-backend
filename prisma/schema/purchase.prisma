// ============================================================
// purchase.prisma
// Purchase Management (SRS Sec. 11) — confirmed purchases
// automatically update inventory via StockMovement.
// ============================================================

model Purchase {
  id                    String          @id @default(cuid())

  businessId            String
  business              Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  supplierId            String
  supplier              Supplier        @relation(fields: [supplierId], references: [id])

  purchaseNumber        String?
  supplierInvoiceNumber String?
  purchaseDate          DateTime        @default(now())

  taxableValue          Decimal         @default(0) @db.Decimal(14, 2)
  cgstAmount            Decimal         @default(0) @db.Decimal(14, 2)
  sgstAmount            Decimal         @default(0) @db.Decimal(14, 2)
  igstAmount            Decimal         @default(0) @db.Decimal(14, 2)
  cessAmount            Decimal         @default(0) @db.Decimal(14, 2)
  gstAmount             Decimal         @default(0) @db.Decimal(14, 2)
  freight               Decimal         @default(0) @db.Decimal(12, 2)
  otherCharges          Decimal         @default(0) @db.Decimal(12, 2)
  roundOff              Decimal         @default(0) @db.Decimal(6, 2)
  totalAmount           Decimal         @default(0) @db.Decimal(14, 2)

  paymentMode           PaymentMode?
  paymentStatus         PaymentStatus   @default(UNPAID)
  status                PurchaseStatus  @default(DRAFT)
  isConfirmed           Boolean         @default(false)

  warehouseId           String?
  notes                 String?
  originalPurchaseId    String?

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  items                 PurchaseItem[]
  ledgerEntries         LedgerEntry[]
  purchaseReturns       PurchaseReturn[]
  debitNotes            DebitNote[]
  payments              Payment[]

  @@unique([businessId, purchaseNumber])
  @@index([businessId, supplierId])
  @@index([businessId, status])
  @@map("purchases")
}

model PurchaseItem {
  id               String   @id @default(cuid())

  purchaseId       String
  purchase         Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId        String
  product          Product  @relation(fields: [productId], references: [id])

  productName      String?
  category         String?
  subCategory      String?
  hsnCode          String?
  quantity         Decimal  @db.Decimal(12, 3)
  unit             String?
  rate             Decimal  @db.Decimal(12, 2)
  discountPercent  Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount   Decimal  @default(0) @db.Decimal(14, 2)

  taxableValue     Decimal  @db.Decimal(14, 2)
  gstRatePercent   Decimal  @default(0) @db.Decimal(5, 2)
  cgstAmount       Decimal  @default(0) @db.Decimal(14, 2)
  sgstAmount       Decimal  @default(0) @db.Decimal(14, 2)
  igstAmount       Decimal  @default(0) @db.Decimal(14, 2)
  cessAmount       Decimal  @default(0) @db.Decimal(14, 2)
  gstAmount        Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal        Decimal  @db.Decimal(14, 2)

  @@index([purchaseId])
  @@map("purchase_items")
}
