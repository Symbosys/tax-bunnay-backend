// ============================================================
// purchase.prisma
// Purchase Management (SRS Sec. 11) — confirmed purchases
// automatically update inventory via StockMovement.
// ============================================================

model Purchase {
  id                  String          @id @default(cuid())

  businessId          String
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  supplierId          String
  supplier            Supplier        @relation(fields: [supplierId], references: [id])

  supplierInvoiceNumber String?
  purchaseDate        DateTime        @default(now())

  taxableValue        Decimal         @default(0) @db.Decimal(14, 2)
  gstAmount           Decimal         @default(0) @db.Decimal(14, 2)
  freight             Decimal         @default(0) @db.Decimal(12, 2)
  otherCharges        Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal         @default(0) @db.Decimal(14, 2)

  paymentStatus       PaymentStatus   @default(UNPAID)
  isConfirmed         Boolean         @default(false)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  items               PurchaseItem[]
  ledgerEntries       LedgerEntry[]
  purchaseReturns     PurchaseReturn[]
  debitNotes          DebitNote[]
  payments            Payment[]

  @@index([businessId, supplierId])
  @@map("purchases")
}

model PurchaseItem {
  id             String   @id @default(cuid())

  purchaseId     String
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  productId      String
  product        Product  @relation(fields: [productId], references: [id])

  hsnCode        String?
  quantity       Decimal  @db.Decimal(12, 3)
  unit           String?
  rate           Decimal  @db.Decimal(12, 2)
  discountPercent Decimal @default(0) @db.Decimal(5, 2)

  taxableValue   Decimal  @db.Decimal(14, 2)
  gstRatePercent Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount      Decimal  @default(0) @db.Decimal(14, 2)
  lineTotal      Decimal  @db.Decimal(14, 2)

  @@index([purchaseId])
  @@map("purchase_items")
}
