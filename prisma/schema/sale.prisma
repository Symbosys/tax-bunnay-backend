// ============================================================
// sale.prisma
// Retail POS Sales & Product Sale Records (SRS Sec. 9 / Sec. 10)
// Every product sold via POS Terminal or Sales Operation is
// recorded in the `sales` table with line items in `sale_items`.
// ============================================================

model Sale {
  id                  String         @id @default(cuid())

  businessId          String
  business            Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)

  saleNumber          String         // e.g. SALE-POS-20260912-0001
  saleDate            DateTime       @default(now())

  customerId          String?
  customer            Customer?      @relation(fields: [customerId], references: [id])
  customerName        String?        // e.g. "Walk-in Customer" or registered name
  customerPhone       String?

  billingAddress      String?
  shippingAddress     String?
  placeOfSupply       String?

  warehouseId         String?
  posSessionId        String?
  cashierName         String?

  subtotal            Decimal        @default(0) @db.Decimal(14, 2)
  discountPercent     Decimal        @default(0) @db.Decimal(5, 2)
  discountAmount      Decimal        @default(0) @db.Decimal(14, 2)

  taxableValue        Decimal        @default(0) @db.Decimal(14, 2)
  cgstAmount          Decimal        @default(0) @db.Decimal(14, 2)
  sgstAmount          Decimal        @default(0) @db.Decimal(14, 2)
  igstAmount          Decimal        @default(0) @db.Decimal(14, 2)
  cessAmount          Decimal        @default(0) @db.Decimal(14, 2)
  roundOff            Decimal        @default(0) @db.Decimal(6, 2)
  grandTotal          Decimal        @default(0) @db.Decimal(14, 2)

  paidAmount          Decimal        @default(0) @db.Decimal(14, 2)
  balanceAmount       Decimal        @default(0) @db.Decimal(14, 2)
  changeReturned      Decimal        @default(0) @db.Decimal(14, 2)

  paymentMode         PaymentMode?
  paymentStatus       PaymentStatus  @default(PAID)

  status              String         @default("COMPLETED") // COMPLETED, DRAFT, HELD, CANCELLED
  isHeld              Boolean        @default(false)

  notes               String?
  termsAndConditions  String?

  invoiceId           String?
  invoice             Invoice?       @relation(fields: [invoiceId], references: [id])

  createdByUserId     String?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  items               SaleItem[]

  @@unique([businessId, saleNumber])
  @@index([businessId, customerId])
  @@index([businessId, saleDate])
  @@index([businessId, status])
  @@index([businessId, invoiceId])
  @@map("sales")
}

/// Line item for a product sale
model SaleItem {
  id                  String         @id @default(cuid())

  saleId              String
  sale                Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId           String?
  product             Product?       @relation(fields: [productId], references: [id])

  productName         String?
  sku                 String?
  barcode             String?
  hsnOrSacCode        String?

  quantity            Decimal        @default(1) @db.Decimal(12, 3)
  unit                String?        @default("PCS")
  rate                Decimal        @db.Decimal(12, 2)
  mrp                 Decimal?       @db.Decimal(12, 2)

  discountPercent     Decimal        @default(0) @db.Decimal(5, 2)
  discountAmount      Decimal        @default(0) @db.Decimal(14, 2)

  taxableValue        Decimal        @db.Decimal(14, 2)
  gstRatePercent      Decimal        @default(0) @db.Decimal(5, 2)
  cgstAmount          Decimal        @default(0) @db.Decimal(14, 2)
  sgstAmount          Decimal        @default(0) @db.Decimal(14, 2)
  igstAmount          Decimal        @default(0) @db.Decimal(14, 2)
  cessAmount          Decimal        @default(0) @db.Decimal(14, 2)
  lineTotal           Decimal        @db.Decimal(14, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}
