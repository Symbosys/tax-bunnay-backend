// ============================================================
// service.prisma
// Service Management (SRS Sec. 8) — no stock quantity needed
// ============================================================

model Service {
  id             String        @id @default(cuid())

  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name           String
  serviceCode    String?
  sacCode        String?
  description    String?

  rate           Decimal       @db.Decimal(12, 2)
  gstRatePercent Decimal       @default(0) @db.Decimal(5, 2)
  unit           String?
  discountPercent Decimal      @default(0) @db.Decimal(5, 2)

  incomeLedgerId String?
  incomeLedger   Account?      @relation(fields: [incomeLedgerId], references: [id])

  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  invoiceItems   InvoiceItem[]

  @@index([businessId])
  @@map("services")
}
