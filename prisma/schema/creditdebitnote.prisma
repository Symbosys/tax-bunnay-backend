// ============================================================
// creditdebitnote.prisma
// Sales Return & Purchase Return (SRS Sec. 12) — each return
// stays linked to its original transaction, adjusts stock, and
// produces a Credit Note (sales) or Debit Note (purchase).
// ============================================================

model SalesReturn {
  id              String             @id @default(cuid())

  businessId      String

  returnNumber    String             // fully rendered, e.g. CN/26-27/0001 or SR-0001
  returnDate      DateTime           @default(now())

  invoiceId       String?
  invoice         Invoice?           @relation(fields: [invoiceId], references: [id])

  customerId      String?
  customerName    String?            // "Walk-in Customer" or entered name
  customerPhone   String?
  billingAddress  String?
  shippingAddress String?
  placeOfSupply   String?

  status          SalesReturnStatus  @default(DRAFT)
  reason          String?            // e.g. "Defective / Damaged Goods"
  refundMode      String?            // e.g. "Credit Note (Store Credit)", "Cash Refund", "UPI Refund"
  warehouseId     String?            // e.g. "main"

  subtotal        Decimal            @default(0) @db.Decimal(14, 2)
  discountAmount  Decimal            @default(0) @db.Decimal(14, 2)
  taxableValue    Decimal            @default(0) @db.Decimal(14, 2)
  cgstAmount      Decimal            @default(0) @db.Decimal(14, 2)
  sgstAmount      Decimal            @default(0) @db.Decimal(14, 2)
  igstAmount      Decimal            @default(0) @db.Decimal(14, 2)
  cessAmount      Decimal            @default(0) @db.Decimal(14, 2)
  roundOff        Decimal            @default(0) @db.Decimal(6, 2)
  totalAmount     Decimal            @default(0) @db.Decimal(14, 2)
  amountRefunded  Decimal            @default(0) @db.Decimal(14, 2)

  notes           String?
  termsConditions String?

  createdByUserId String?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items           SalesReturnItem[]
  creditNote      CreditNote?

  @@unique([businessId, returnNumber])
  @@index([businessId, customerId])
  @@index([businessId, invoiceId])
  @@index([businessId, status])
  @@index([businessId, returnDate])
  @@map("sales_returns")
}

model SalesReturnItem {
  id                 String      @id @default(cuid())

  salesReturnId      String
  salesReturn        SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  productId          String?
  serviceId          String?
  productName        String?
  hsnSac             String?
  unit               String?     @default("PCS")

  quantity           Decimal     @db.Decimal(12, 3)
  rate               Decimal     @db.Decimal(12, 2)
  discountPercentage Decimal     @default(0) @db.Decimal(5, 2)
  discountAmount     Decimal     @default(0) @db.Decimal(14, 2)

  taxableValue       Decimal     @db.Decimal(14, 2)
  gstRatePercent     Decimal     @default(0) @db.Decimal(5, 2)
  cgstAmount         Decimal     @default(0) @db.Decimal(14, 2)
  sgstAmount         Decimal     @default(0) @db.Decimal(14, 2)
  igstAmount         Decimal     @default(0) @db.Decimal(14, 2)
  cessAmount         Decimal     @default(0) @db.Decimal(14, 2)
  lineTotal          Decimal     @default(0) @db.Decimal(14, 2)

  reason             String?
  stockRestocked     Boolean     @default(false)

  @@index([salesReturnId])
  @@index([productId])
  @@map("sales_return_items")
}

model CreditNote {
  id             String       @id @default(cuid())

  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  noteNumber     String
  noteDate       DateTime     @default(now())

  invoiceId      String?
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])

  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])

  salesReturnId  String?      @unique
  salesReturn    SalesReturn? @relation(fields: [salesReturnId], references: [id])

  amount         Decimal      @db.Decimal(14, 2)
  reason         String?

  createdAt      DateTime     @default(now())

  @@unique([businessId, noteNumber])
  @@map("credit_notes")
}

model PurchaseReturn {
  id               String               @id @default(cuid())

  businessId       String

  purchaseId       String
  purchase         Purchase             @relation(fields: [purchaseId], references: [id])

  returnDate       DateTime             @default(now())
  reason           String?
  notes            String?
  status           PurchaseReturnStatus @default(DRAFT)

  taxableValue     Decimal              @default(0) @db.Decimal(14, 2)
  gstAmount        Decimal              @default(0) @db.Decimal(14, 2)
  totalAmount      Decimal              @default(0) @db.Decimal(14, 2)
  amountAdjusted   Decimal              @default(0) @db.Decimal(14, 2)

  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  items            PurchaseReturnItem[]
  debitNote        DebitNote?

  @@index([businessId, purchaseId])
  @@index([businessId, status])
  @@index([businessId, returnDate])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                String         @id @default(cuid())

  purchaseReturnId  String
  purchaseReturn    PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  productId         String
  productName       String?
  hsnCode           String?
  unit              String?
  quantity          Decimal        @db.Decimal(12, 3)
  rate              Decimal        @db.Decimal(12, 2)
  gstRatePercent    Decimal        @default(0) @db.Decimal(5, 2)
  taxableValue      Decimal        @db.Decimal(14, 2)
  gstAmount         Decimal        @default(0) @db.Decimal(14, 2)
  lineTotal         Decimal        @default(0) @db.Decimal(14, 2)
  returnReason      String?

  @@index([purchaseReturnId])
  @@index([productId])
  @@map("purchase_return_items")
}

model DebitNote {
  id                String          @id @default(cuid())

  businessId        String
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  noteNumber        String
  noteDate          DateTime        @default(now())

  purchaseId        String
  purchase          Purchase        @relation(fields: [purchaseId], references: [id])

  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id])

  purchaseReturnId  String?         @unique
  purchaseReturn    PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id])

  amount            Decimal         @db.Decimal(14, 2)
  reason            String?

  createdAt         DateTime        @default(now())

  @@unique([businessId, noteNumber])
  @@map("debit_notes")
}
