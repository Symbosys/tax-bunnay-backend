// ============================================================
// creditdebitnote.prisma
// Sales Return & Purchase Return (SRS Sec. 12) — each return
// stays linked to its original transaction, adjusts stock, and
// produces a Credit Note (sales) or Debit Note (purchase).
// ============================================================

model SalesReturn {
  id            String       @id @default(cuid())

  businessId    String

  invoiceId     String
  invoice       Invoice      @relation(fields: [invoiceId], references: [id])

  returnDate    DateTime     @default(now())
  reason        String?

  taxableValue  Decimal      @default(0) @db.Decimal(14, 2)
  gstAmount     Decimal      @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal      @default(0) @db.Decimal(14, 2)

  createdAt     DateTime     @default(now())

  items         SalesReturnItem[]
  creditNote    CreditNote?

  @@index([businessId, invoiceId])
  @@map("sales_returns")
}

model SalesReturnItem {
  id             String      @id @default(cuid())

  salesReturnId  String
  salesReturn    SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  productId      String
  quantity       Decimal     @db.Decimal(12, 3)
  rate           Decimal     @db.Decimal(12, 2)
  taxableValue   Decimal     @db.Decimal(14, 2)
  gstAmount      Decimal     @default(0) @db.Decimal(14, 2)

  @@index([salesReturnId])
  @@map("sales_return_items")
}

model CreditNote {
  id             String       @id @default(cuid())

  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  noteNumber     String
  noteDate       DateTime     @default(now())

  invoiceId      String
  invoice        Invoice      @relation(fields: [invoiceId], references: [id])

  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])

  salesReturnId  String?      @unique
  salesReturn    SalesReturn? @relation(fields: [salesReturnId], references: [id])

  amount         Decimal      @db.Decimal(14, 2)
  reason         String?

  createdAt      DateTime     @default(now())

  @@unique([businessId, noteNumber])
  @@map("credit_notes")
}

model PurchaseReturn {
  id            String       @id @default(cuid())

  businessId    String

  purchaseId    String
  purchase      Purchase     @relation(fields: [purchaseId], references: [id])

  returnDate    DateTime     @default(now())
  reason        String?

  taxableValue  Decimal      @default(0) @db.Decimal(14, 2)
  gstAmount     Decimal      @default(0) @db.Decimal(14, 2)
  totalAmount   Decimal      @default(0) @db.Decimal(14, 2)

  createdAt     DateTime     @default(now())

  items         PurchaseReturnItem[]
  debitNote     DebitNote?

  @@index([businessId, purchaseId])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id                String         @id @default(cuid())

  purchaseReturnId  String
  purchaseReturn    PurchaseReturn @relation(fields: [purchaseReturnId], references: [id], onDelete: Cascade)

  productId         String
  quantity          Decimal        @db.Decimal(12, 3)
  rate              Decimal        @db.Decimal(12, 2)
  taxableValue      Decimal        @db.Decimal(14, 2)
  gstAmount         Decimal        @default(0) @db.Decimal(14, 2)

  @@index([purchaseReturnId])
  @@map("purchase_return_items")
}

model DebitNote {
  id                String          @id @default(cuid())

  businessId        String
  business          Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  noteNumber        String
  noteDate          DateTime        @default(now())

  purchaseId        String
  purchase          Purchase        @relation(fields: [purchaseId], references: [id])

  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id])

  purchaseReturnId  String?         @unique
  purchaseReturn    PurchaseReturn? @relation(fields: [purchaseReturnId], references: [id])

  amount            Decimal         @db.Decimal(14, 2)
  reason            String?

  createdAt         DateTime        @default(now())

  @@unique([businessId, noteNumber])
  @@map("debit_notes")
}
