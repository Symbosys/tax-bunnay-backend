// ============================================================
// inventory.prisma
// Multi-Warehouse (SRS Sec. 17) + Inventory Management (Sec. 16)
// Every stock-affecting transaction writes a StockMovement row,
// so Stock Summary / Stock Ledger / Valuation can be derived.
// ============================================================

model Warehouse {
  id           String          @id @default(cuid())

  businessId   String
  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name         String          // e.g. Main Warehouse, Branch, Retail Store, Godown, Production Unit
  address      String?
  isDefault    Boolean         @default(false)
  isActive     Boolean         @default(true)

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  products         Product[]
  stockMovements   StockMovement[]
  transfersOut     StockTransfer[] @relation("FromWarehouse")
  transfersIn      StockTransfer[] @relation("ToWarehouse")

  @@index([businessId])
  @@map("warehouses")
}

/// Immutable log of every stock-in / stock-out event, per product per warehouse
model StockMovement {
  id            String            @id @default(cuid())

  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)

  productId     String
  product       Product           @relation(fields: [productId], references: [id])

  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])

  movementType  StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)   // positive = stock in, negative = stock out
  unitCost      Decimal?          @db.Decimal(12, 2)

  batchNumber   String?
  serialNumber  String?
  expiryDate    DateTime?

  referenceType String?           // "INVOICE" | "PURCHASE" | "SALES_RETURN" | "PURCHASE_RETURN" | "PRODUCTION" ...
  referenceId   String?

  movementDate  DateTime          @default(now())
  createdAt     DateTime          @default(now())

  @@index([businessId, productId, warehouseId])
  @@map("stock_movements")
}

/// Warehouse-to-warehouse stock transfer (SRS Sec. 17)
model StockTransfer {
  id              String    @id @default(cuid())

  businessId      String

  fromWarehouseId String
  fromWarehouse   Warehouse @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])

  toWarehouseId   String
  toWarehouse     Warehouse @relation("ToWarehouse", fields: [toWarehouseId], references: [id])

  transferDate    DateTime  @default(now())
  notes           String?

  createdAt       DateTime  @default(now())

  items           StockTransferItem[]

  @@index([businessId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id              String        @id @default(cuid())

  stockTransferId String
  stockTransfer   StockTransfer @relation(fields: [stockTransferId], references: [id], onDelete: Cascade)

  productId       String
  quantity        Decimal       @db.Decimal(12, 3)

  @@index([stockTransferId])
  @@map("stock_transfer_items")
}
