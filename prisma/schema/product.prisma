// ============================================================
// product.prisma
// Product & Item Management (SRS Sec. 7)
// ============================================================

model Product {
  id                String        @id @default(cuid())

  businessId        String
  business          Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name              String
  itemCode          String?
  sku               String?
  barcode           String?

  hsnCode           String?
  primaryUnit       String        // e.g. PCS, KG, BOX
  secondaryUnit     String?
  gstRatePercent    Decimal       @default(0) @db.Decimal(5, 2)

  purchasePrice     Decimal?      @db.Decimal(12, 2)
  sellingPrice      Decimal?      @db.Decimal(12, 2)
  mrp               Decimal?      @db.Decimal(12, 2)
  wholesalePrice    Decimal?      @db.Decimal(12, 2)

  minStockLevel     Decimal?      @db.Decimal(12, 2)
  openingStock      Decimal       @default(0) @db.Decimal(12, 2)

  hasBatchTracking  Boolean       @default(false)
  hasSerialTracking Boolean       @default(false)
  hasExpiryTracking Boolean       @default(false)

  warehouseId       String?
  warehouse         Warehouse?    @relation(fields: [warehouseId], references: [id])
  rackOrBin         String?

  supplierId        String?
  supplier          Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  category          String?
  subCategory       String?
  brand             String?

  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  invoiceItems      InvoiceItem[]
  purchaseItems     PurchaseItem[]
  stockMovements    StockMovement[]
  priceListEntries  ProductPrice[]
  bomComponentIn    BomItem[]
  productionOutputs ProductionOrder[] @relation("FinishedProduct")

  @@index([businessId])
  @@index([supplierId])
  @@map("products")
}

/// Customer-specific / group-specific pricing (SRS Sec. 7 — different pricing levels)
model ProductPrice {
  id           String   @id @default(cuid())

  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  priceListName String  // e.g. "Retail", "Wholesale", "Customer: ABC Traders"
  price        Decimal  @db.Decimal(12, 2)

  createdAt    DateTime @default(now())

  @@index([productId])
  @@map("product_prices")
}
